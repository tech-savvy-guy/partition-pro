{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "noEmit": true,
    "paths": {
      "@/*": ["*"],
      "@core/*": ["core/*"],
      "@pages/*": ["pages/*"],
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
