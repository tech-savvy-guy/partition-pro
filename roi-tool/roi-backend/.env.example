# Local development example only. Do not put real secrets in this file.

# Django
DJANGO_SECRET=change-me-local-only
DEBUG=True
DJANGO_SETTINGS_MODULE=Security_api_settings.settings

# RS256 JWT keys. Use local throwaway keys only, escaped as a single line with \n.
PRIVATE_KEY=local-only-rs256-private-key-placeholder
PUBLIC_KEY=local-only-rs256-public-key-placeholder

# PostgreSQL. Use a local or disposable database only.
ENGINE=django.db.backends.postgresql
NAME=roi_backend_local
USER=roi_backend_local
PASSWORD=local-password-only
HOST=localhost
PORT=5432

# Azure Blob Storage. Use local/emulated or disposable resources only.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_ACCOUNT_NAME=localstore
AZURE_STORAGE_ACCOUNT_KEY=local-placeholder-only
AZURE_UPLOAD_CONTAINER_NAME=uploads

# Redis. Use local or disposable Redis only.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local-password-only

# Secret source. Keep ENVIRONMENT for local development.
KEYMETHOD=ENVIRONMENT
VAULT_CLIENT_ID=local-placeholder-only
VAULT_CLIENT_SECRET=local-placeholder-only
VAULT_TENANT_ID=local-placeholder-only
AZURE_KEY_VAULT=https://local-placeholder.vault.azure.net/
